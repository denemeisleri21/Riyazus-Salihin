<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/shamua_bg">

    <!-- Sürekli Kaydırma Görünümü (Dikey veya Yatay) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerContinuous"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:overScrollMode="ifContentScrolls" />

    <!-- Hadis Bazlı Sağa-Sola Sayfalama Görünümü -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPagerHadith"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- Yükleniyor Göstergesi -->
    <LinearLayout
        android:id="@+id/loadingContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <ProgressBar
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:indeterminate="true" />

        <TextView
            android:id="@+id/tvLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/loading_book"
            android:textColor="@color/shamua_text"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- Üst Menü Çubuğu (Ortaya dokununca açılır/kapanır) -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@color/shamua_surface"
        android:elevation="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="10dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTopChapter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/app_name"
                android:textColor="@color/shamua_text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTopSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="1. Cilt • Hadis 1 / 1903"
                android:textColor="@color/shamua_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnTopBookmark"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/menu_bookmarks"
            android:padding="9dp"
            android:src="@drawable/ic_bookmark" />

        <ImageButton
            android:id="@+id/btnTopFavorite"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/menu_favorites"
            android:padding="9dp"
            android:src="@drawable/ic_favorite" />
    </LinearLayout>

    <!-- Alt Menü Çubuğu (İçindekiler, Yer İmleri, Favoriler, Ayarlar) -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/shamua_surface"
        android:elevation="8dp"
        android:orientation="horizontal"
        android:paddingTop="8dp"
        android:paddingBottom="10dp"
        android:weightSum="4">

        <LinearLayout
            android:id="@+id/navToc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="6dp">

            <ImageView
                android:id="@+id/ivNavToc"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_menu_toc" />

            <TextView
                android:id="@+id/tvNavToc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/menu_toc"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navBookmarks"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="6dp">

            <ImageView
                android:id="@+id/ivNavBookmarks"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_bookmark" />

            <TextView
                android:id="@+id/tvNavBookmarks"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/menu_bookmarks"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navFavorites"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="6dp">

            <ImageView
                android:id="@+id/ivNavFavorites"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_favorite" />

            <TextView
                android:id="@+id/tvNavFavorites"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/menu_favorites"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navSettings"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="6dp">

            <ImageView
                android:id="@+id/ivNavSettings"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_settings" />

            <TextView
                android:id="@+id/tvNavSettings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/menu_settings"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
