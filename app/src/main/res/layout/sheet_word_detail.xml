<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wordDetailRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvWordDetailHeader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/word_detail_title"
            android:textSize="13sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnCloseWordDetail"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close" />
    
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnOpenSita"
        style="?attr/materialButtonOutlinedStyle"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="16dp"
        android:text="@string/open_in_sita"
        android:textSize="13.5sp" />

</LinearLayout>


    <!-- Tıklanan Arapça Kelime -->
    <TextView
        android:id="@+id/tvWordArabic"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/noto_naskh_arabic_bold"
        android:gravity="center"
        android:textDirection="rtl"
        android:textSize="32sp" />

    <!-- Kök Rozeti -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvWordRootBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill"
            android:paddingStart="14dp"
            android:paddingTop="5dp"
            android:paddingEnd="14dp"
            android:paddingBottom="5dp"
            android:textSize="14sp"
            android:textStyle="bold" />
    
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnOpenSita"
        style="?attr/materialButtonOutlinedStyle"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="16dp"
        android:text="@string/open_in_sita"
        android:textSize="13.5sp" />

</LinearLayout>


    <View
        android:id="@+id/wordDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="14dp" />

    <!-- Anlamı -->
    <TextView
        android:id="@+id/tvLabelMeaning"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/word_label_meaning"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvWordMeaning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="serif"
        android:lineSpacingMultiplier="1.35"
        android:textSize="16.5sp" />

    <!-- Kök Hakkında Kısa Bilgi -->
    <TextView
        android:id="@+id/tvLabelRootInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/word_label_root_info"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvWordRootInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:lineSpacingMultiplier="1.35"
        android:textSize="14sp" />

    <!-- Yapı / Ek Analizi (varsa) -->
    <TextView
        android:id="@+id/tvLabelMorph"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/word_label_morphology"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvWordMorph"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:textSize="13sp"
        android:visibility="gone" />


    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnOpenSita"
        style="?attr/materialButtonOutlinedStyle"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="16dp"
        android:text="@string/open_in_sita"
        android:textSize="13.5sp" />

</LinearLayout>

